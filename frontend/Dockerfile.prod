# Production Next.js image (multi-stage). Used by docker-compose.prod.yml on a VPS.
# For Vercel deploys this file is unused — Vercel builds the app natively.

FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* .npmrc ./
RUN npm install
COPY . .
# NEXT_PUBLIC_* is baked into the bundle at build time, so it must be present here.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package.json /app/package-lock.json* ./
COPY --from=builder /app/.npmrc ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["npm", "run", "start"]
