# syntax=docker/dockerfile:1
# Backend image for Hugging Face Spaces (Docker SDK).
# HF Spaces requires the app to listen on port 7860.
#
# Models (FinBERT + bge embeddings + spaCy) are baked into the image so a cold
# start doesn't also pay a multi-GB download — on the free tier the container's
# disk is ephemeral, so a runtime cache would re-download every wake-up.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Cache models inside the image layer (baked at build time, below)
    HF_HOME=/opt/models \
    # Chroma writes here; ephemeral on free Spaces (re-ingest filings after a rebuild)
    CHROMA_PATH=/data/chroma

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

# Bake the NER + sentiment + embedding models into the image
RUN python -m spacy download en_core_web_sm
RUN python -c "\
from transformers import AutoModelForSequenceClassification, AutoTokenizer; \
AutoTokenizer.from_pretrained('ProsusAI/finbert'); \
AutoModelForSequenceClassification.from_pretrained('ProsusAI/finbert')"
RUN python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('BAAI/bge-large-en-v1.5')"

WORKDIR /app
COPY . .

# HF Spaces mounts persistent storage at /data (paid) or gives ephemeral /data (free)
RUN mkdir -p /data/chroma

EXPOSE 7860
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
