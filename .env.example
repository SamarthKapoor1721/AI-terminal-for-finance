# ─────────────────────────────────────────────────────────────
# AI Bloomberg Terminal — Environment Configuration
# Copy to `.env` and adjust. All AI runs locally (no paid APIs).
# ─────────────────────────────────────────────────────────────

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- Postgres ---
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL is derived from the above in config.py, but can be overridden:
# DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/finance

# --- Redis (Celery broker / cache) ---
REDIS_URL=redis://redis:6379/0

# --- LLM backend ---
# If GROQ_API_KEY is set, Groq (fast cloud) is used; else local Ollama.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local fallback (Ollama: Qwen 3)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# --- Embeddings (HuggingFace, local) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- Sentiment (FinBERT, local) ---
FINBERT_MODEL=ProsusAI/finbert

# --- ChromaDB (vector store) ---
CHROMA_PATH=/data/chroma

# --- Economic data (optional, Phase 11) — free key: https://fred.stlouisfed.org ---
FRED_API_KEY=

# --- Optional data providers (free tiers). Leave blank to use yfinance. ---
# Finnhub (free 60/min): https://finnhub.io/register  → reliable quotes + news
FINNHUB_API_KEY=
# Financial Modeling Prep (free 250/day): https://site.financialmodelingprep.com
FMP_API_KEY=

# --- SEC EDGAR (no key; just identify yourself per SEC policy) ---
SEC_USER_AGENT=AI Bloomberg Terminal your-email@example.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
